# Copy to .env (git-ignored) and fill in.

# Gemini (option A: AI Studio API key - free tier). Used only for summaries.
GOOGLE_API_KEY=

# Gemini (option B: Vertex AI - billed to project; leave GOOGLE_API_KEY empty)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gmail (requires 2-Step Verification + App password; IMAP enabled for feedback)
GMAIL_USER=anhnguyen.workmail@gmail.com
GMAIL_APP_PASSWORD=
DIGEST_TO=anhnguyen.workmail@gmail.com

# Optional: link shown in the email footer to the digest archive
# ARCHIVE_URL=https://github.com/anh-nguyen-iconic/news_update/tree/main/digests
